{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {},
    // 소스 디렉터리나 프로젝트 루트에 캐시 파일이 노출되지 않도록
    // node_modules 내부 캐시 디렉터리에 저장합니다.
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "generated"]
}
